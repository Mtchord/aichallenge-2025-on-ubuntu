# The settings in this file file are the same as in cppad.pc except for the
# following line:
# includedir=/aichallenge/workspace/src/aichallenge_submit/CppAD/include
#
prefix=/aichallenge/install/cppad
exec_prefix=${prefix}
includedir=/aichallenge/workspace/src/aichallenge_submit/CppAD/include
libdir=${exec_prefix}/lib
#
Name:                  cppad
Description:           Differentiation of C++ Algorithms
Version:               20250623
URL:                   https://coin-or.github.io/CppAD
#
Cflags:                -I${includedir}
Libs:                  -L/aichallenge/install/cppad/lib -lcppad_lib
Requires:               eigen3
Libs.private           
Requires.private:      
